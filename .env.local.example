# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# UUIDs (separados por virgula) dos usuarios donos da plataforma.
# Vazio ou ausente = ninguem e admin (fail-closed).
PLATFORM_ADMIN_USER_IDS=

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# URL pública canônica deste deploy (esquema + host, sem barra final).
#
# OBRIGATÓRIA para conectar WhatsApp via Evolution: POST
# /api/whatsapp/evolution/connect e /connect-public usam SOMENTE esta
# variável para montar a URL do webhook (nunca um header da
# requisição, nem com allowlist). Sem ela, as duas rotas devolvem 503
# em vez de registrar um webhook. Isso é proposital, não um bug: a URL
# do webhook carrega EVOLUTION_WEBHOOK_SECRET no caminho, e vira o
# DESTINO de uma chamada de saída que a própria Evolution faz de volta
# para o CRM. Se essas rotas aceitassem Host/X-Forwarded-Host da
# requisição, um header forjado faria a Evolution entregar esse
# segredo para o host escolhido por quem forjou o header (a barreira
# para forjar o header é baixa: connect só exige ser admin de QUALQUER
# conta, e connect-public só exige um token de conexão sem login).
#
# Também usada como base dos links de convite (POST
# /api/account/invitations): nesse caso, sem a env, a origem é
# derivada da própria requisição (Host / X-Forwarded-Host, com a
# allowlist ALLOWED_INVITE_HOSTS abaixo como camada extra), então
# setar isto ali é recomendado, não obrigatório. Só é obrigatória
# mesmo para o fluxo da Evolution acima.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the openinbox.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Only affects invite links. The Evolution webhook URL
# (EVOLUTION_WEBHOOK_SECRET below) does NOT use this allow-list: it
# requires NEXT_PUBLIC_SITE_URL and never falls back to a header at
# all, allow-listed or not (see src/lib/http/base-url.ts).
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required for
# OAuth do Meta Ads no Portal de Clientes e também para criar/editar
# templates com cabeçalho IMAGE: a Meta só aceita um
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
META_APP_ID=your-meta-app-id

# Runbook do app global da agência (WhatsApp + templates + OAuth Meta Ads):
# docs/meta-app-configuracao.md

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# Evolution API (conectar WhatsApp por QR Code)
# ------------------------------------------------------------------
# As TRÊS variáveis abaixo funcionam como um conjunto: usar a Evolution
# é opcional (dá para operar só com a API oficial da Meta), mas se for
# usar, faltando qualquer uma delas o fluxo do QR Code não sai do lugar.
# Cada uma falha com uma mensagem própria em
# POST /api/whatsapp/evolution/connect, todas com status 503:
#
#   sem API_URL ou API_KEY  → "Evolution não configurada no servidor"
#   sem WEBHOOK_SECRET      → "Webhook da Evolution não configurado no servidor"
#   sem NEXT_PUBLIC_SITE_URL→ "URL pública do app não configurada no servidor"
#
# Depois de preencher e redeployar, é preciso RECONECTAR pelo QR Code:
# a URL do webhook fica registrada dentro da instância na Evolution, e
# só é reescrita quando a instância é criada de novo.

# Endereço do seu servidor Evolution, sem barra final.
#   EVOLUTION_API_URL=https://evolution.seu-dominio.com
# EVOLUTION_API_URL=

# Chave global de autenticação da Evolution (AUTHENTICATION_API_KEY no
# .env do servidor Evolution). Vai no header `apikey` de toda chamada.
# EVOLUTION_API_KEY=

# Segredo do webhook da Evolution. Vai no CAMINHO da URL registrada na
# instância: /api/whatsapp/evolution/webhook/<segredo>. A rota compara
# esse segredo em tempo constante contra o que vem no caminho.
#
# Fail-closed: sem esta variável (ausente, vazia ou só espaço), a rota
# do webhook não processa nenhum evento (responde 200 sem tocar no
# banco, só para a Evolution não entrar em loop de retry) e
# POST /api/whatsapp/evolution/connect e /connect-public devolvem 503
# em vez de registrar um webhook sem proteção. Um segredo do caminho
# que não bate com esta env responde 404 (não 401), para não confirmar
# a quem estiver sondando que a rota existe.
#
# Gere com:
#   openssl rand -hex 32
# EVOLUTION_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Administradores de plataforma (pool de proxies)
# ------------------------------------------------------------------
# Lista de UUIDs (separados por vírgula, espaços em volta são
# ignorados) dos usuários autorizados a gerenciar o pool de proxies
# global da agência (GET/POST /api/proxies, PATCH/DELETE
# /api/proxies/[id]). Este pool não pertence a nenhuma conta
# (`account_id`) e as rotas usam o cliente com service role, então
# `requireRole("owner")` NÃO se aplica aqui: qualquer pessoa que se
# cadastra em /signup já vira "owner" da própria conta nova. Esta
# variável é o único portão de autorização dessas rotas.
#
# Fail-closed: se esta variável estiver ausente ou vazia, NINGUÉM
# consegue gerenciar o pool de proxies (nem mesmo um "owner"). Isso é
# proposital, não um bug — defina a variável explicitamente para
# liberar o acesso a quem precisa.
#
# Como descobrir o UUID de um usuário: no Supabase Studio, abra
# Authentication → Users e copie o "User UID" da pessoa desejada, ou
# rode `select id, email from auth.users where email = '...';` no
# SQL Editor.
#
# Exemplo:
#   PLATFORM_ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# PLATFORM_ADMIN_USER_IDS=

# IP público da VPS. Usado por /api/proxies/health para detectar
# vazamento: se um proxy responder com este IP, o tráfego não está
# passando por ele, e o proxy é desativado na hora.
# VPS_PUBLIC_IP=31.97.249.95

# ============================================================
# Feedback in-app → chamado no ClickUp
#
# Usadas pela rota POST /api/feedback, que abre uma tarefa quando alguém
# relata um problema pelo card na barra lateral.
#
# ATENÇÃO: o token é da conta da NOSSA operação (a agência), não de
# conta de cliente. Os chamados chegam para quem cuida do sistema.
#
# Se o token ou a lista faltarem, o relato AINDA é gravado no banco e a
# pessoa vê "recebemos" — falha de configuração nossa não vira erro na
# cara de quem está usando. O motivo fica no log e na coluna `error` da
# tabela feedback_reports.
# ============================================================

# Personal API Token: ClickUp > Settings > Apps > API Token.
# CLICKUP_FEEDBACK_TOKEN=pk_...

# Id da lista que recebe os chamados. Está na URL da lista no ClickUp:
# .../v/li/<ESTE_NUMERO>
# CLICKUP_FEEDBACK_LIST_ID=901234567890

# Opcional. Id numérico de quem fica como responsável; vários separados
# por vírgula. Sem isto, a tarefa é atribuída ao dono do token.
#
# Por que importa: no ClickUp quem CRIA não vira responsável. Tarefa sem
# responsável não aparece no "Assigned to me" de ninguém e o chamado
# morre sem ser visto.
# CLICKUP_FEEDBACK_ASSIGNEE_ID=12345678
